# Browser Agent 环境变量
# 复制此文件为 .env 并填入你的 key

# 本地 qwen2api (默认, 免费)
# 无需配置, 默认 http://127.0.0.1:7860/v1

# x.ai (Grok) - 可选
# XAI_API_KEY=xai-xxx

# OpenAI - 可选
# OPENAI_API_KEY=sk-xxx

# Anthropic - 可选
# ANTHROPIC_API_KEY=sk-ant-xxx

# Google - 可选
# GOOGLE_API_KEY=AIzaxxx

# Ollama (本地, 免费)
# 已默认配置 http://localhost:11434
